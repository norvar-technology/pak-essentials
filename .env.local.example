# -----------------------------------------------------------------------
# Pak Essentials — environment variables
# -----------------------------------------------------------------------
# Copy this file to ".env.local" (same folder) and fill in real values.
# ".env.local" is already git-ignored, so your secret key never gets
# committed or pushed anywhere.
#
# When you deploy on Vercel, add these SAME variable names under
# Project Settings → Environment Variables. Vercel does NOT read
# .env.local from your repo (it's ignored on purpose for security),
# so you must paste the values into the dashboard as well.
# -----------------------------------------------------------------------

# Public base URL of your deployed site (no trailing slash).
# Used to build absolute Open Graph image URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://pakessentialsenterprise.ng

# The domain your Cloudflare R2 bucket serves images from.
# Examples:
#   NEXT_PUBLIC_R2_DOMAIN=pub-XXXXXXXXXXXXXXXX.r2.dev
#   NEXT_PUBLIC_R2_DOMAIN=images.pakessentials.com   (custom domain)
NEXT_PUBLIC_R2_DOMAIN=file.decklo.xyz

# WhatsApp number that receives customer chats AND finished orders.
# Must be in international format with NO "+", spaces or dashes.
# Example for a Nigerian number 0803 123 4567 -> 2348031234567
NEXT_PUBLIC_WHATSAPP_NUMBER=2348031234567

# Paystack PUBLIC key (safe to expose in the browser — starts with pk_).
# Get it from Paystack Dashboard → Settings → API Keys & Webhooks.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack SECRET key (NEVER exposed to the browser — starts with sk_).
# Only used inside app/api/verify-payment/route.js, which runs on
# Vercel's server, never in the client bundle.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
